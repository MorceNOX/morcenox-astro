pkgname=morcenox-astro
pkgver=0.0.0
pkgrel=1
pkgdesc="Traditional Astrology calculation engine and TUI powered by Swiss Ephemeris"
arch=('x86_64')
url="https://github.com"
license=('GPL3')
depends=('ncurses' 'icu')
makedepends=('gcc' 'make' 'gettext')
options=('!debug')
source=("MorceNOX-Astro-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "MorceNOX-Astro-$pkgver"
    make clean
    make PREFIX=/usr
}

package() {
    cd "MorceNOX-Astro-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}

