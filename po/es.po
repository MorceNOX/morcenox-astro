msgstr ""

#: src/draw-chart.c:3856
msgid "A day marked by a certain restlessness and heightened sensitivity."
msgstr ""

#: src/draw-chart.c:3859
msgid "A day for communications, studies, business, and partnerships."
msgstr ""

#: src/draw-chart.c:3862
msgid "A day associated with pleasure and comfort."
msgstr ""

#: src/draw-chart.c:3865
msgid "Beginnings, action, competition, achievements, and discipline."
msgstr ""

#: src/draw-chart.c:3868
