#: src/temperament.c:907 src/temperament.c:934 src/temperament.c:960
#: src/temperament.c:991 src/temperament.c:1019 src/temperament.c:1049
#: src/temperament.c:1076 src/temperament.c:1102 src/temperament.c:1128
msgid ""
"Characteristics:\n"
"\n"
